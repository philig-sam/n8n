    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const url_import = require('node:url');\n\nconst html = $json.data;\nconst url = $('Notion Webhook').item.json.body.data.properties['Media Recommendation'].url;\nconst extraText = $('Notion Webhook').item.json.body.data.properties['Media Recommendation Text']?.rich_text[0]?.plain_text ?? null;\n\n// Parse Open Graph meta tags using regex\nconst getMetaTag = (name) => {\n  const regex = new RegExp(`<meta[^>]*(?:property|name)=[\"']og:${name}[\"'][^>]*content=[\"']([^\"']*)[\"']`, 'i');\n  const altRegex = new RegExp(`<meta[^>]*content=[\"']([^\"']*)[\"'][^>]*(?:property|name)=[\"']og:${name}[\"']`, 'i');\n\n  const match = html.match(regex) || html.match(altRegex);\n  return match ? match[1] : null;\n};\n\nconst getPageTitle = () => {\n  const match = html?.match(\n    /<head\\b[^>]*>[\\s\\S]*?<title\\b[^>]*>([\\s\\S]*?)<\\/title>[\\s\\S]*?<\\/head>/i\n  );\n  return match\n    ? match[1].replace(/\\s+/g, ' ').trim()\n    : null;\n};\n\n// Extract domain from URL\nconst domain = new url_import.URL(url).hostname;\n\n// Detect type based on URL patterns\nconst detectType = (url, ogType) => {\n  if (ogType === 'video' || url.includes('youtube.com') || url.includes('vimeo.com')) return 'Video';\n  if (url.includes('github.com')) return 'GitHub';\n  if (ogType === 'article') return 'Blog';\n  return 'Website';\n};\n\nconst ogType = getMetaTag('type');\n\nreturn {\n  json: {\n    media_recommendation: {\n      url: url,\n      title: getMetaTag('title') || getMetaTag('site_name') || getPageTitle(),\n      description: getMetaTag('description'),\n      image: getMetaTag('image'),\n      type: detectType(url, ogType),\n      domain: domain,\n      extra_text: extraText\n    }\n  }\n};\n"
      },
