{
  "name": "Send Tech Newsletter",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// Some topics from the Notion gets mapped to the same topic in the Newsletter\n// Example: AI and Agents get mapped to \"Artificial Intelligence\"\nconst topicMap = {\n  \"AI\": \"🤖 Artificial Intelligence\",\n  \"Fancy Technology\": \"🤩 Fancy Technology\",\n  \"Software Development\": \"💻 Software Development\",  \n  \"Cloud & SaaS\": \"☁️ Cloud & SaaS\",\n  \"Business\": \"🚀 Business\",\n  \"Modern Work\": \"💼 Modern Work\",  \n  \"Career\": \"📈 Career\",\n  \"Research\": \"👩‍🔬 Research\",  \n  \"Security\": \"🔐 Security\",\n  \"Other\": \"📰 Other\",\n  \"Recommendations\": \"⭐ Recommendations\",\n};\n\n// Group the news by the topics they get mapped to\nconst grouped = {};\n\nfor (const item of $('Get all Tech News of Issue').all()) {\n  // Find the right category\n  const category = topicMap[item.json.property_newsletter_category] || \"📰 Other\";\n\n  // Create the category, if it doesn't exist\n  if (!grouped[category]) {\n    grouped[category] = { title: category, articles: [] };\n  }\n\n  // Add the article to the category\n  let article = {\n    description: item.json.property_summary,\n    title: item.json.property_name,\n    url: item.json.property_url || item.json.url,\n    comment: item.json.property_editor_comment ? {} : null\n  }\n\n  if (item.json.property_editor_comment) {\n    article.comment = {\n      author: \"Robin-Manuel Thiel\",\n      content: item.json.property_editor_comment\n    }\n  }\n  \n  grouped[category].articles.push(article);\n}\n\n// Enforce the order from topicMap\nconst orderedResult = [];\nconst uniqueCategories = [...new Set(Object.values(topicMap))];\n\nfor (const cat of uniqueCategories) {\n  if (grouped[cat]) {\n    orderedResult.push(grouped[cat]);\n  }\n}\n\nconst content = {\n  \"issue_title\": $('Notion Webhook').first().json.body.data.properties.Name.title[0].plain_text,\n  \"issue_date\": $now.toFormat(\"MMMM dd, yyyy\"),\n  \"issue_number\": $('Notion Webhook').first().json.body.data.properties.Number.number,\n  \"issue_range\": $now.minus({days: 7}).toFormat(\"MMM dd, yyyy\") + \" - \" + $now.toFormat(\"MMM dd, yyyy\"),\n  \"welcome\": $('Notion Webhook').first().json.body.data.properties.Welcome.rich_text[0].plain_text,\n  \"fast_five\": $input.all().filter(x => x.json.property_top_news).map(x => ({\n    title: x.json.name,\n    url: x.json.property_url || x.json.url\n  })).slice(0, 5),\n  \"categories\": Object.values(orderedResult),\n  \"media_recommendation\": $('Set Media Recommendation').first().json.media_recommendation\n}\n\nreturn [content]"
      },
