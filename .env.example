# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Database (SQLite file; swap to a postgres:// URL later - schema is provider-agnostic)
DATABASE_URL="file:./dev.db"

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vendor Intelligence <intel@example.com>"

# App
APP_BASE_URL=http://localhost:3000
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-too-a-long-random-string

# When true, no emails are actually sent - they are logged instead
DRY_RUN=true

# Cron schedules (5-field cron syntax, evaluated in server-local time)
CRON_POLL_SOURCES="0 */6 * * *"
CRON_PROCESS_ITEMS="15 */6 * * *"
CRON_SEND_ALERTS="0 * * * *"
CRON_SEND_DIGESTS="0 7 1 1,4,7,10 *"

# If true, subscribers with zero new events in the period are skipped (no empty digest email)
SKIP_EMPTY_DIGESTS=true
